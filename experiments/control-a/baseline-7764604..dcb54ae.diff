+    var animatableData: CGFloat {
+        get { progress }
+        set { progress = newValue }
+    }
+
+    func path(in rect: CGRect) -> Path {
+        RoundedRectangle(cornerRadius: 52 * min(max(progress * 4, 0), 1), style: .continuous).path(in: rect)
     }
 }
 
