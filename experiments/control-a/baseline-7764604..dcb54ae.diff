+    @MainActor func testWorkspaceRevealKeepsCollectionState() {
+        continueAfterFailure = false
+        let app = XCUIApplication()
+        app.launchEnvironment["FOLIO_TEST_LIBRARY"] = UUID().uuidString
+        app.launchEnvironment["FOLIO_TEST_COUNT"] = "60"
+        app.launch()
+        let inbox = app.buttons["workspace.inbox"]
+        let menu = app.buttons["collection.menu"]
+        let search = app.textFields["collection.search"]
+        let searchButton = app.buttons["collection.searchButton"]
+        let closers = app.buttons.matching(NSPredicate(format: "label == %@", "Close Workspace"))
+        XCTAssertTrue(inbox.waitForExistence(timeout: 10))
+        XCTAssertEqual(menu.label, "Close Workspace")
+        XCTAssertEqual(closers.count, 1, "The open workspace has one close control")
+        XCTAssertTrue(searchButton.isHittable)
+        XCTAssertFalse(search.exists)
+        capture(app, "reveal-open")
+        inbox.tap()
+        XCTAssertTrue(search.waitForExistence(timeout: 8))
+        XCTAssertEqual(menu.label, "Show Workspace")
+        XCTAssertFalse(inbox.exists)
+        XCTAssertFalse(searchButton.exists)
+        capture(app, "reveal-closed")
+
